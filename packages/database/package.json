{
  "name": "@auibsal/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/types.ts",
    "./constants": "./src/constants.ts",
    "./aliases": "./src/aliases.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./dtos/*": "./src/dtos/*.ts",
    "./queries/*": "./src/queries/*.ts",
    "./mutations/*": "./src/mutations/*.ts",
    "./rpc/*": "./src/rpc/*.ts"
  },
  "scripts": {
    "lint": "biome check . --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules",
    "generate": "pnpm dlx supabase@latest gen types typescript --project-id dgjxwsttotfqcvtgujry > src/types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@auibsal/config": "workspace:*",
    "typescript": "catalog:"
  }
}
