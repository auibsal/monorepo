{
  "extends": "@auibsal/config/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    // =========================
    // Monorepo Type Caching
    // =========================
    "composite": true,
    "declaration": true,
    "declarationMap": true,

    // =========================
    // Clean Output
    // =========================
    "noEmit": false,
    "emitDeclarationOnly": true,
    "sourceMap": false
  },
  "include": ["src/**/*"]
}
