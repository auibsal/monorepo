{
  "extends": "@auibsal/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*"
  ]
}
