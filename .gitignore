# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust / WebAssembly
target/
pkg/
Cargo.lock
.turbo/

# Playwright and NextJS
screenshots/
playwright-report/
test-results/
.env.local
*.log
packages/**/dist/
packages/**/*.js
packages/**/*.d.ts
packages/**/*.js.map

# Autogenerated Next/Playwright stuff
apps/dashboard/.gitignore
apps/dashboard/AGENTS.md
apps/dashboard/CLAUDE.md
apps/dashboard/eslint.config.mjs
apps/dashboard/next.config.ts
apps/dashboard/public/
apps/dashboard/README.md

packages/ui/.gitignore
packages/ui/CLAUDE.md
packages/ui/components.json
packages/ui/eslint.config.mjs
packages/ui/next.config.ts
packages/ui/public/
packages/ui/README.md
