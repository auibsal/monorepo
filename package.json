{
  "name": "auibsal-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,css}\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@auibsal/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "latest",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "msw",
      "unrs-resolver"
    ]
