{
  "name": "auibsal-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --cache",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,css}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs,css}\" --cache",
    "generate:notices": "pnpm licenses list --prod > THIRD-PARTY-NOTICES.txt"
  },
  "devDependencies": {
    "@auibsal/config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "client-only": "^0.0.1",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "server-only": "^0.0.1",
    "turbo": "latest",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  }
}
