# =========================================================================
# AUIB SAL Monorepo - Environment Blueprint
# Copy this file to .env.local and populate it with actual development keys
# =========================================================================

# -------------------------------------------------------------------------
# 1. Routing & Domains
# -------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_NEXUS_URL=http://localhost:3001

# -------------------------------------------------------------------------
# 2. Public Client-Side Environment Variables (Supabase)
# Default values below map to the local `supabase start` Docker environment
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey... # Get from `supabase status`

# -------------------------------------------------------------------------
# 3. Private Server-Side Environment Variables (Supabase / Auth)
# -------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=ey...             # Matches NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=ey...     # Get from `supabase status`
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# NOTE: If you are integrating a payment gateway, uncomment and use these standard names
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Wayl Payment Gateway Integration
PRIMARY_PAYMENT_PROVIDER=wayl
WAYL_ENV=test
WAYL_API_KEY=your_wayl_api_key_here
WAYL_WEBHOOK_URL=http://localhost:3001/api/webhooks/wayl
WAYL_WEBHOOK_SECRET=your_wayl_webhook_secret_here

# -------------------------------------------------------------------------
# 4. Database Infrastructure
# -------------------------------------------------------------------------
# Prisma / Edge Serverless Connection (Uses Connection Pooling - Port 6543 on remote, 54322 locally)
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Standard Backend Connection (Uses Direct Connection - Port 5432)
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:5432/postgres
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Individual connection breakdowns (Often used by external scripts/migrations)
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres

# -------------------------------------------------------------------------
# 5. Third-Party Integrations & Communications
# -------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
