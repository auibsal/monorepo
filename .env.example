# =========================================================================
# AUIB SAL Monorepo - Environment Blueprint
# Copy this file to .env.local and populate it with actual development keys
# =========================================================================

# -------------------------------------------------------------------------
# 1. Routing & Domains (Local Development Defaults)
# -------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_NEXUS_URL=http://localhost:3001

# -------------------------------------------------------------------------
# 2. Public Client-Side Environment Variables (Supabase)
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------------------
# 3. Private Server-Side Environment Variables (Supabase / Auth / SSR)
# -------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=secret-service-role-key-do-not-leak
SUPABASE_JWT_SECRET=your-supabase-jwt-signing-secret

# Note: Only populate these if your configuration explicitly maps alternative keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# -------------------------------------------------------------------------
# 4. Database Infrastructure (PostgreSQL / Prisma / Local Docker)
# -------------------------------------------------------------------------
# Local fallback connection string example: postgresql://postgres:postgres@localhost:5432/auib_sal
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Individual connection breakdowns for localized script execution
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=auib_sal

# -------------------------------------------------------------------------
# 5. Third-Party Integrations & Communications
# -------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
