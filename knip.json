{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted"],
  "ignoreDependencies": [
    "import-in-the-middle",
    "require-in-the-middle",
    "sharp",
    "tailwindcss",
    "@tailwindcss/postcss",
    "postcss-load-config"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@repo/typescript-config"]
    },
    "apps/api": {
      "entry": ["scripts/*.{js,mjs,ts}"]
    },
    "apps/app": {
      "entry": ["public/sw.js"]
    },
    "packages/email": {
      "ignoreDependencies": ["react-dom", "@types/react-dom"]
    }
  }
}
