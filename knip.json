{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted", "exports", "types"],
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/postcss",
    "postcss-load-config"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@repo/typescript-config"]
    },
    "apps/web": {
      "entry": ["scripts/*.ts", "public/sw.js"]
    },
    "packages/email": {
      "ignoreDependencies": ["react-dom", "@types/react-dom"]
    },
    "packages/brand": {
      "ignore": ["assets/**", "components/ui/**"]
    }
  }
}
