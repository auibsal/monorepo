{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "javascript": {
    "globals": []
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        // Inline handlers are idiomatic React; the re-render cost is negligible
        // and the React Compiler memoizes them where it matters.
        "noJsxPropsBind": "off"
      },
      "style": {
        // Short patterns (dates, slugs, codes) read best with numbered
        // groups; named groups are used where a match has several parts.
        "useNamedCaptureGroup": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*",
      // Generated by the shadcn CLI; updated with `bun run bump-ui`.
      "!packages/brand/components/ui",
      "!packages/brand/lib",
      "!packages/brand/hooks",
      // Generated from packages/brand/assets/icons by `bun run --cwd packages/brand icons`.
      "!packages/brand/components/sal/icon-data.ts",
      "!apps/email/.react-email",
      // The brand's own export, kept as supplied.
      "!packages/brand/assets",
      "!apps/web/public/brand",
      "!apps/web/app/icon.svg",
      // Supabase Auth templates: Go template syntax, pasted into the dashboard.
      "!packages/database/supabase/templates",
      "!apps/e2e/test-results",
      "!apps/e2e/playwright-report"
    ]
  },
  "overrides": [
    {
      // Playwright journeys: inline URL and name patterns read best in place,
      // and steps run one after another on purpose.
      "includes": ["apps/e2e/**"],
      "linter": {
        "rules": {
          "performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" }
        }
      }
    },
    {
      // Each Tailwind @utility is its own scope, so the same :lang(ar)
      // selector in two utilities is not a duplicate.
      "includes": ["packages/brand/styles/**"],
      "linter": {
        "rules": { "suspicious": { "noDuplicateSelectors": "off" } }
      }
    },
    {
      // Generated by `bun run db:types`: formatted, never linted.
      "includes": ["packages/database/types.ts"],
      "assist": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
