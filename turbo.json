{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "**/generated/**",
        "storybook-static/**",
        "design/**"
      ]
    },
    "typecheck": {},
    "test": {},
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "SKIP_ENV_VALIDATION",
    "ANALYZE",
    "NEXT_PUBLIC_*",
    "SUPABASE_INTEGRATION",
    "API_URL",
    "PUBLISHABLE_KEY",
    "SECRET_KEY",
    "SERVICE_ROLE_KEY",
    "MAILPIT_URL",
    "INBUCKET_URL",
    "SUPABASE_URL",
    "SUPABASE_SECRET_KEY",
    "E2E_*",
    "PLAYWRIGHT_*"
  ],
  "globalPassThroughEnv": [
    "CRON_SECRET",
    "DATABASE_WEBHOOK_SECRET",
    "GOOGLE_WALLET_ISSUER_ID",
    "GOOGLE_WALLET_PRIVATE_KEY",
    "GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL",
    "NOTION_TOKEN",
    "RESEND_TOKEN",
    "RESEND_WEBHOOK_SECRET",
    "REVALIDATE_SECRET",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_BOT_USERNAME",
    "TELEGRAM_LOGIN_CLIENT_SECRET",
    "TELEGRAM_WEBHOOK_SECRET",
    "TURNSTILE_SECRET_KEY",
    "POSTGRES_*",
    "SUPABASE_ANON_KEY",
    "SUPABASE_JWT_SECRET",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SERVICE_ROLE_KEY"
  ]
}
