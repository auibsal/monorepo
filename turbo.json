{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "**/generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {},
    "test": {},
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "SKIP_ENV_VALIDATION",
    "ANALYZE",
    "NEXT_PUBLIC_*",
    "SUPABASE_INTEGRATION",
    "API_URL",
    "PUBLISHABLE_KEY",
    "SECRET_KEY",
    "SERVICE_ROLE_KEY",
    "MAILPIT_URL",
    "INBUCKET_URL",
    "SUPABASE_URL",
    "SUPABASE_SECRET_KEY",
    "E2E_*",
    "PLAYWRIGHT_*",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ]
}
