{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(bunx supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./apps/*/.env)",
      "Read(./apps/*/.env.local)",
      "Read(./apps/*/.env.production)",
      "Read(./packages/*/.env)",
      "Read(./packages/*/.env.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx|*.js|*.mjs|*.json|*.css) bunx biome check --no-errors-on-unmatched \"$f\" >&2 || exit 2 ;; esac"
          }
        ]
      }
    ]
  }
}
