{
  "extends": "@auibsal/config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    // 1. Explicitly define the DOM environment and JSX transform
    // to prevent the Next.js compiler from automatically rewriting this file.
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@auibsal/ui/*": ["../../packages/ui/src/*"],
      "@auibsal/ui/components/*": ["../../packages/ui/src/components/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".turbo" // 2. Enforce the cache blackout
  ]
}
