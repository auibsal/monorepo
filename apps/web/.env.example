# apps/web: the public site at auibsal.org. Published reads only, with the
# publishable key (RLS applies). No service-role key here, ever.

# ── URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"

# ── Supabase: the publishable key only ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""

# ── Revalidation (shared with apps/api; `openssl rand -hex 32`) ────────────
REVALIDATE_SECRET=""

# ── Email (Resend) — contact form ──────────────────────────────────────────
RESEND_FROM="SAL <hello@auibsal.org>"
RESEND_TOKEN=""

# ── Analytics (docs/platform/analytics.md): nothing loads until set ────────
# GTM container (GA4 is configured inside it). Public IDs, not secrets.
NEXT_PUBLIC_GTM_ID=""
# GA4 alone, without GTM (leave empty when GTM is used).
NEXT_PUBLIC_GA_ID=""
# Google tag gateway measurement path on auibsal.org (Cloudflare), e.g. /metrics
NEXT_PUBLIC_TAG_GATEWAY_PATH=""

# ── Waraq's AdSense ads (docs/platform/ads.md): nothing loads until set ────
# AdSense publisher ID (ca-pub-…) and the display ad unit's slot number.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT=""

# ── Observability (Sentry: errors and logs) ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
