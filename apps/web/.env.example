# The one app: auibsal.org (the public pages), auibsal.org/diwan (the
# member portal) and auibsal.org/api (the API routes). Variables without
# NEXT_PUBLIC_ are server-only and read in route handlers and lib/api alone.

# ── The site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase (Settings → API Keys) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Bypasses Row Level Security: server-only (webhooks, cron, exports).
SUPABASE_SECRET_KEY=""
# Leave empty (one origin). Production keeps ".auibsal.org" only because the
# members' existing sessions carry that domain (packages/auth/cookies.ts).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""
# Cloudflare Turnstile site key (public), for Supabase Auth's human check on
# sign-up, sign-in and reset. Leave empty locally (the check is off there).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Its secret half, for the API routes' check on public forms (forms,
# removal requests, the Sunday Paper, Associate requests). Server-only.
TURNSTILE_SECRET_KEY=""

# ── Shared secrets (`openssl rand -hex 32` each) ───────────────────────────
# Vercel Cron sends CRON_SECRET as a Bearer token.
CRON_SECRET=""
# The Supabase database webhook on core.outbox sends this as a Bearer token.
DATABASE_WEBHOOK_SECRET=""
# Bearer token for POST /api/revalidate (calls from outside this app).
REVALIDATE_SECRET=""

# ── Email (Resend, sending from auibsal.org) ───────────────────────────────
RESEND_TOKEN=""
# Bulk mail's subdomain, once verified in Resend (docs/platform/settings.md).
RESEND_BULK_DOMAIN=""
# Resend's webhook signing secret (whsec_…) for bounces and complaints at
# /api/hooks/resend. Server-only.
RESEND_WEBHOOK_SECRET=""
# Vercel → Team Settings → Webhooks (deployment.error, deployment.succeeded
# for production): its secret, for /api/hooks/vercel. Server-only.
VERCEL_WEBHOOK_SECRET=""
# Supabase Auth → Hooks → Send Email (HTTPS): the secret it shows (v1,whsec_…).
SEND_EMAIL_HOOK_SECRET=""

# ── Notion (the team workspace) ────────────────────────────────────────────
# Notion → Settings → Connections → Develop or manage integrations → the
# "SAL Platform" connection (API token). Also allow it to read user
# information including email addresses. Empty: no Notion sync.
NOTION_TOKEN=""
# The same connection → Webhooks: subscription https://auibsal.org/api/hooks/notion.
# Notion sends a verification token there once (it shows in the Vercel log);
# paste it into Notion to verify, and here. Empty: changes reach the site
# with the 15-minute sync only.
NOTION_WEBHOOK_SECRET=""

# ── Analytics: Vercel Web Analytics, cookieless; nothing to set here
# (turn it on in the Vercel project; docs/platform/analytics.md) ────────────

# ── Phone notifications (Web Push) ─────────────────────────────────────────
# `bunx web-push generate-vapid-keys` makes the pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── Google Wallet (the membership card as a pass) ──────────────────────────
# Google Pay & Wallet Console → issuer id; a Google Cloud service account
# with the Wallet API, added as a user of the issuer; its JSON key's
# client_email and private_key (newlines as \n). docs/platform/wallet.md.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""

# ── Telegram (Hudhud, lib/api/bot) ─────────────────────────────────────────
# From @BotFather. Empty: no bot, and notices go by email and push only. For
# local development use a separate test bot (`bun run telegram:dev` removes
# that bot's webhook and polls instead).
TELEGRAM_BOT_TOKEN=""
# The bot's username without the @ (it ends in "bot").
TELEGRAM_BOT_USERNAME=""
# Telegram sends it with every update to /api/telegram; `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=""
# BotFather → Bot Settings → Login Widget → OpenID Connect: the Client Secret.
# Members link Telegram from their Membership settings with it (it never signs
# anyone in). Empty: they link with the bot's one-time code instead.
TELEGRAM_LOGIN_CLIENT_SECRET=""
