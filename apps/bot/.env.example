# apps/bot: Hudhud, the Society's Telegram bot. Server-only secrets.

# ── Telegram (@BotFather) ───────────────────────────────────────────────────
# The bot's token. For local development use a separate test bot: `bun run
# dev` removes the webhook of whatever bot the token belongs to.
TELEGRAM_BOT_TOKEN=""
# The bot's username without the @ (it must end in "bot").
TELEGRAM_BOT_USERNAME=""
# Sent by Telegram with every update; `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=""
# Optional: where Telegram delivers updates. Default: the project's
# production domain + /api/telegram.
TELEGRAM_WEBHOOK_URL=""

# ── Scheduled posts ─────────────────────────────────────────────────────────
# The same value as apps/api's CRON_SECRET (Vault: cron_secret). pg_cron
# sends it to /api/cron; it also guards /api/setup.
CRON_SECRET=""

# ── Supabase (Settings → API Keys) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Bypasses Row Level Security. apps/api, apps/bot and CI only.
SUPABASE_SECRET_KEY=""
